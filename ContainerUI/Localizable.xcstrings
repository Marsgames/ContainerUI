    "onboarding.cli.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ContainerUI requires Apple's container CLI, available with macOS 26 Tahoe. If it's not installed, the app will guide you."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ContainerUI nécessite le CLI container d'Apple, disponible avec macOS 26 Tahoe. S'il n'est pas installé, l'application vous guidera."
          }
        }
      }
    },
    "onboarding.cli.title" : {
      "localizations" : {
