        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nécessite macOS 26 Tahoe"
          }
        }
      }
    },
    "onboarding.ready.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manage containers and images, stream logs, pull from registries — all from a clean native interface."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gérez vos conteneurs et images, consultez les journaux en direct, tirez depuis des registres — depuis une interface native épurée."
          }
        }
      }
    },
    "onboarding.ready.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're all set"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout est prêt"
          }
        }
      }
    },
    "onboarding.welcome.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A native macOS interface for Apple's container system. Lightweight, open source, and built for developers."
