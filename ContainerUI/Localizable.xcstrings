    "Help" : {
      "comment" : "A button that displays help information when pressed.",
      "isCommentAutoGenerated" : true
    },
    "help.containers.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This list shows all containers on your system — running and stopped.\n\n• Tap a row to inspect details and logs.\n• Use ▶ to start, ■ to stop, ↺ to restart.\n• Use 🗑 to permanently delete a container."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette liste affiche tous les conteneurs de votre système — en cours d'exécution et arrêtés.\n\n• Appuyez sur une ligne pour inspecter les détails et les journaux.\n• Utilisez ▶ pour démarrer, ■ pour arrêter, ↺ pour redémarrer.\n• Utilisez 🗑 pour supprimer définitivement un conteneur."
          }
        }
      }
    },
    "help.containers.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Containers"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conteneurs"
          }
        }
      }
    },
    "help.images.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Local images pulled from a registry or built from a Dockerfile.\n\n• Use ↓ in the toolbar to pull a new image.\n• Enter any OCI reference, e.g. docker.io/library/debian:latest.\n• Use 🗑 to remove an image."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Images locales tirées d'un registre ou construites depuis un Dockerfile.\n\n• Utilisez ↓ dans la barre d'outils pour télécharger une image.\n• Saisissez n'importe quelle référence OCI, ex. docker.io/library/debian:latest.\n• Utilisez 🗑 pour supprimer une image."
          }
        }
      }
    },
    "help.images.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Images"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Images"
          }
        }
      }
    },
    "help.registries.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authenticated registries for pulling and pushing images.\n\n• Use + to add a registry with your credentials.\n• Credentials are stored securely in the macOS Keychain.\n• Click Logout to remove a registry."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registres authentifiés pour télécharger et pousser des images.\n\n• Utilisez + pour ajouter un registre avec vos identifiants.\n• Les identifiants sont stockés de façon sécurisée dans le Trousseau macOS.\n• Cliquez sur Déconnecter pour retirer un registre."
          }
        }
      }
    },
    "help.registries.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registries"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registres"
          }
        }
      }
    },
